{
  "name": "telegram-apex",
  "version": "10.1.0",
  "description": "Telegram APEX ULTRA - desktop shell",
  "main": "main.js",
  "author": "teldigi5-wq",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "security:test": "node --test navigation-policy.test.js electron-security.test.js"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.teldigi5wq.telegramapex",
    "productName": "Telegram APEX",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "navigation-policy.js"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
